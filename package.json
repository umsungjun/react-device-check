{
  "name": "react-device-check",
  "version": "0.1.0",
  "description": "Lightweight, accurate, SSR-safe React hooks for device detection. Detect device type (mobile/tablet/desktop) and OS (iOS/Android/Windows/macOS/Linux) with zero dependencies. Handles iPad-as-Mac masquerading, Samsung DeX, and User-Agent reduction. TypeScript support included.",
  "author": "umsungjun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umsungjun/react-device-check.git"
  },
  "bugs": {
    "url": "https://github.com/umsungjun/react-device-check/issues"
  },
  "homepage": "https://github.com/umsungjun/react-device-check#readme",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.d.ts','dist/index.d.mts')\"",
    "prepublishOnly": "pnpm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "example": "cd examples/basic && pnpm install && pnpm dev",
    "example:next": "cd examples/nextjs && pnpm install && pnpm dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "size": "size-limit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "size-limit": [
    {
      "name": "everything",
      "path": "dist/index.mjs",
      "import": "*",
      "limit": "2 kB"
    },
    {
      "name": "useIsMobile only (tree-shaken)",
      "path": "dist/index.mjs",
      "import": "{ useIsMobile }",
      "limit": "1.15 kB"
    },
    {
      "name": "useDevice only",
      "path": "dist/index.mjs",
      "import": "{ useDevice }",
      "limit": "1.5 kB"
    },
    {
      "name": "detectDevice only (no React)",
      "path": "dist/index.mjs",
      "import": "{ detectDevice }",
      "limit": "0.9 kB"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.2",
    "vitest": "^4.0.17"
  },
  "packageManager": "pnpm@10.5.2",
  "keywords": [
    "react",
    "react-hook",
    "hooks",
    "device-detection",
    "device-detect",
    "react-device-detect",
    "detect-device",
    "mobile-detect",
    "is-mobile",
    "is-tablet",
    "is-desktop",
    "ios",
    "android",
    "ipad",
    "iphone",
    "tablet",
    "user-agent",
    "useragentdata",
    "client-hints",
    "ssr",
    "nextjs",
    "hydration",
    "responsive",
    "typescript",
    "zero-dependencies",
    "tree-shakeable"
  ]
}
